# SHACL shapes for the BSBM-flavored version content generated by
# benchmark.versioning.VersionGraphGenerator — closed-world validation.
# Each shape is annotated with its constraint family of
# Version-history-inference-validation.md §7, which decides the merge
# policies that can break it (§7.4):
#   - deterministic-witness shapes (sh:class via sh:targetSubjectsOf, §7.2)
#     detect the dangling references (loss damage) produced by INTERSECTION
#     and SYMMETRIC_DIFFERENCE merges and deleting transitions;
#   - witness shapes (sh:minCount via sh:targetClass, §7.2) detect lost
#     mandatory values, and their target/path split straddles under UNION
#     (§7.1);
#   - upper-bound shapes (sh:maxCount, §7.1) detect conflict damage
#     (values accumulated by a UNION merge);
#   - intrinsic shapes (sh:datatype, sh:pattern, sh:nodeKind,
#     sh:minInclusive/sh:maxInclusive) are safe under every policy
#     (locality lemma, §7.4) and detect malformed values.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/> .
@prefix shp:  <http://example.org/shapes/> .

# --- Products ---------------------------------------------------------------

# A declared product keeps a label, with at most one per language
# (witness constraint with a non-deterministic witness + upper bound).
shp:ProductLabelShape
    a sh:NodeShape ;
    sh:targetClass bsbm:Product ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
    ] .

# --- Offers -----------------------------------------------------------------

# An offer has at most one price, and prices are well-formed decimal
# strings (upper bound + intrinsic constraints).
shp:OfferShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:price ;
    sh:property [
        sh:path bsbm:price ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+\\.[0-9]+$" ;
    ] .

# A declared offer keeps its price and its product link (witness
# constraints with non-deterministic witnesses: endangered by INTERSECTION
# and SYMMETRIC_DIFFERENCE, and straddling under UNION since the type and
# the value can come from different branches, §7.1–§7.2).
shp:OfferCompletenessShape
    a sh:NodeShape ;
    sh:targetClass bsbm:Offer ;
    sh:property [
        sh:path bsbm:price ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bsbm:product ;
        sh:minCount 1 ;
    ] .

# Referential integrity: an offer sells a single declared product
# (deterministic witness + upper bound).
shp:OfferProductShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:product ;
    sh:property [
        sh:path bsbm:product ;
        sh:class bsbm:Product ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

# Referential integrity: an offer is sold by a single declared vendor
# (deterministic witness + upper bound).
shp:OfferVendorShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:vendor ;
    sh:property [
        sh:path bsbm:vendor ;
        sh:class bsbm:Vendor ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] .

# Delivery delays are single positive integers (upper bound + intrinsic).
shp:DeliveryDaysShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:deliveryDays ;
    sh:property [
        sh:path bsbm:deliveryDays ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
    ] .

# --- Reviews ----------------------------------------------------------------

# Referential integrity: every review points to a declared product
# (deterministic witness, §7.2).
shp:ReviewShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:reviewFor ;
    sh:property [
        sh:path bsbm:reviewFor ;
        sh:class bsbm:Product ;
        sh:minCount 1 ;
    ] .

# A rating is a single well-formed integer on the 1..10 scale
# (upper bound + intrinsic constraints).
shp:RatingShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:rating1 ;
    sh:property [
        sh:path bsbm:rating1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 10 ;
    ] .

# --- Vendors ----------------------------------------------------------------

# A vendor has at most one country, given as a well-formed two-letter code
# (upper bound + intrinsic constraints).
shp:VendorCountryShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:country ;
    sh:property [
        sh:path bsbm:country ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{2}$" ;
    ] .
