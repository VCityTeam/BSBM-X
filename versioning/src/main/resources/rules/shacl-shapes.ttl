# SHACL shapes for the BSBM-flavored version content generated by
# benchmark.versioning.VersionGraphGenerator — closed-world validation.
# See Version-history-inference-validation.md §11:
#   - ReviewShape is a witness constraint with a deterministic witness
#     (§7.2): it detects the dangling references (loss damage) produced by
#     INTERSECTION and SYMMETRIC_DIFFERENCE merges and deleting transitions;
#   - OfferShape carries upper-bound and intrinsic constraints (§7.1): it
#     detects conflict damage (several prices accumulated by a UNION merge)
#     and malformed values.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/> .
@prefix shp:  <http://example.org/shapes/> .

# Referential integrity: every review points to a declared product.
shp:ReviewShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:reviewFor ;
    sh:property [
        sh:path bsbm:reviewFor ;
        sh:class bsbm:Product ;
        sh:minCount 1 ;
    ] .

# An offer has at most one price, and prices are well-formed decimal strings.
shp:OfferShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bsbm:price ;
    sh:property [
        sh:path bsbm:price ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+\\.[0-9]+$" ;
    ] .
